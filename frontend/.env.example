# Lemaiyan's Travels - Environment Configuration (Option A: Unified Next.js)

# Site URL
NEXT_PUBLIC_SITE_URL=https://lemaiyanstravels.co.ke

# Optional: Custom API URL (Leave blank for unified Next.js same-origin /api routes)
NEXT_PUBLIC_API_URL=

# Email Dispatch Configuration (Nodemailer)
# Destination address where web inquiries will be received
CONTACT_EMAIL=lemaiyans@gmail.com

# SMTP Provider Settings (e.g. Gmail App Password, Resend, or SendGrid SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
